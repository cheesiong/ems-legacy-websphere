<!-- SYNTHETIC LEGACY SAMPLE — illustrative only, not real client code. -->
<!-- Deployment descriptor for the EMS-WEB-TICKETS module. -->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>EMS-WEB-TICKETS</display-name>

    <servlet>
        <servlet-name>TicketServlet</servlet-name>
        <servlet-class>sg.demo.ems.web.TicketServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>TicketServlet</servlet-name>
        <!-- catch-all mapping; the servlet itself dispatches on an
             "action" request parameter rather than the URL path -->
        <url-pattern>/tickets/*</url-pattern>
    </servlet-mapping>

    <!-- Shared header/footer fragments and pages are UTF-8. -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
        </jsp-property-group>
    </jsp-config>

    <!-- Landing page is the operations dashboard; ticket-list.jsp is still
         reachable directly and from the side menu. -->
    <welcome-file-list>
        <welcome-file>dashboard.jsp</welcome-file>
        <welcome-file>ticket-list.jsp</welcome-file>
    </welcome-file-list>

    <!-- NOTE: the error page prints the raw exception message to the user. -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>

</web-app>
